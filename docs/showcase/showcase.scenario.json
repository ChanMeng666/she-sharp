{
  "project": "she-sharp",
  "baseUrl": "https://she-sharp-zeta.vercel.app",
  "outDir": "docs/showcase",
  "loginWall": false,

  "viewports": {
    "desktop": { "width": 1920, "height": 1080, "deviceScaleFactor": 2 },
    "mobile":  { "width": 390,  "height": 844,  "deviceScaleFactor": 3, "isMobile": true }
  },

  "reducedMotion": "reduce",

  "setup": [
    { "action": "click", "selector": "button:has-text('Accept all')", "optional": true, "timeoutMs": 5000 },
    { "action": "wait", "ms": 500 }
  ],

  "pages": [
    {
      "label": "hero",
      "url": "/",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 }
      ]
    },
    {
      "label": "events-full",
      "url": "/events",
      "viewport": "desktop",
      "fullPage": true,
      "maxHeight": 5000,
      "before": [
        { "action": "wait", "ms": 1500 }
      ]
    },
    {
      "label": "mentorship",
      "url": "/mentorship",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 1500 }
      ]
    },
    {
      "label": "mobile-home",
      "url": "/",
      "viewport": "mobile",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 }
      ]
    }
  ],

  "demo": {
    "size": { "width": 1280, "height": 720 },
    "stepPauseMs": 400,
    "steps": [
      { "action": "goto", "url": "/", "timeoutMs": 15000 },
      { "action": "wait", "ms": 2000 },
      { "action": "scroll", "by": 500 },
      { "action": "wait", "ms": 1800 },
      { "action": "scroll", "by": 500 },
      { "action": "wait", "ms": 1800 },
      { "action": "goto", "url": "/mentorship", "timeoutMs": 12000 },
      { "action": "wait", "ms": 2000 }
    ]
  }
}
