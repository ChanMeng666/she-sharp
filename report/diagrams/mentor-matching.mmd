---
config:
  theme: base
  themeVariables:
    fontFamily: "Instrument Sans, Segoe UI, Arial, sans-serif"
    fontSize: "15px"
    background: "#ffffff"
    primaryColor: "#f7e5f3"
    primaryTextColor: "#1f1e44"
    primaryBorderColor: "#9b2e83"
    secondaryColor: "#f4f4fa"
    secondaryBorderColor: "#8982ff"
    tertiaryColor: "#effefb"
    tertiaryBorderColor: "#b1f6e9"
    mainBkg: "#f7e5f3"
    nodeBorder: "#9b2e83"
    nodeTextColor: "#1f1e44"
    lineColor: "#8982ff"
    textColor: "#1f1e44"
    titleColor: "#9b2e83"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f4f4fa"
    clusterBorder: "#c4c1ff"
  flowchart:
    curve: basis
    nodeSpacing: 46
    rankSpacing: 58
    padding: 22
    useMaxWidth: false
    htmlLabels: false
  htmlLabels: false
---
flowchart TB
  subgraph MENTEE ["Mentee"]
    direction TB
    M1["Signs up"] --> M2["Profile and goals"]
  end

  subgraph MENTOR ["Mentor"]
    direction TB
    N1["Onboarded"] --> N2["Skills, capacity,<br/>availability"]
  end

  MATCH{{"Matching criteria"}}

  M2 --> MATCH
  N2 --> MATCH

  MATCH --> P["Proposed pair"]
  P --> A["Both accept"]
  A --> C["Six-month cycle"]
  C --> R["Three-month<br/>check-in"]
  R --> S["Close-out survey"]

  classDef menteeNode fill:#f7e5f3,stroke:#9b2e83,stroke-width:2px,color:#1f1e44;
  classDef mentorNode fill:#f4f4fa,stroke:#8982ff,stroke-width:2px,color:#1f1e44;
  classDef pivot fill:#ffffff,stroke:#9b2e83,stroke-width:2.5px,color:#9b2e83;
  classDef cycle fill:#effefb,stroke:#57c9b3,stroke-width:2px,color:#1f1e44;

  class M1,M2 menteeNode;
  class N1,N2 mentorNode;
  class MATCH,P,A pivot;
  class C,R,S cycle;
