# Build output. The draft PDF and the page previews are regenerated by
# report/build.ps1 on demand and must never be committed — a stale committed
# draft is indistinguishable from a current one.
out/

# Full-resolution mmdc output, before prepare-assets.mjs quantises it. The
# committed artifact is report/assets/diagrams/*.png, not these scratch renders.
diagrams/.raw/

# Node scratch, if anyone runs a script from inside this directory.
node_modules/

# The FINAL report is written to public/docs/ and IS committed — it is what the
# site links to. It is deliberately not listed here.
