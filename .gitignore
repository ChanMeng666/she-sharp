*~

# Claude AI — ignore personal state (settings.local.json etc.) but keep skills tracked.
.claude/*
!.claude/skills/
# Cached skill artifacts (channel dumps, downloaded docx/images for extraction) — local-only.
.cache/
.claude/skills/**/.cache/
WARP.md

# Email preview files
tmp/

# Host run-of-show scripts for in-person events. Local only — never publish.
# Lives outside tmp/ so a local `CI=true npx next build` that clears tmp/
# cannot wipe the night-of script.
/host-scripts/

# Newsletter photo pipeline scratch (harvested + transcoded event photos)

# Local-only scripts (not for deployment)
scripts/collect-event-from-slack.py
scripts/requirements-slack.txt

# Newsletter pilot contact list (contains real emails — local-only)
scripts/newsletter/pilot-contacts.local.csv

# Any recipient list dropped into the repo (Humanitix exports, sign-up sheets).
# Real email addresses — never commit these.
**/*.local.csv

# Same rule in JSON. The newsletter reviewer roster is split in two: the NAMES
# and roles are committed in lib/email/newsletter-reviewers.ts so a diff shows
# who is on the round, and the ADDRESSES live in
# .claude/skills/monthly-newsletter/state/reviewers.local.json, which this
# covers. Most reviewers hold personal off-domain mailboxes, and an address in
# git is permanent — a volunteer who leaves stays in the history.
# `*.local.example.json` does NOT match this pattern, so the committed example
# (fake addresses, for the shape) stays tracked.
**/*.local.json

# ...but the hashed suppression list carries no PII and MUST stay tracked.
!lib/data/json/email-suppression-hashes.json

# Raw ticketing exports and anything derived from them that still carries a real
# name, address or code. lib/data/json/humanitix/ holds the safe, derived,
# committed archive; this holds the source it was built from — 5,156 attendee
# rows and 124 live access codes. Never committed.
# See docs/development/HUMANITIX_ARCHIVE.md.
/private/

# Generated audit reports (local tooling output, not tracked)
scripts/audit-report.json

# Reference/Example projects
reference-next-shadcn-admin-dashboard/
nul

# Audit script HTML cache
scripts/.cache/
scripts/__pycache__/

# LinkedIn recommendation generator output (local-only)
.recommendations/
/scripts/slack-recommendations
.playwright-cli/
.env*
