  "matching": {
    "caseSensitive": false,
    "collapseWhitespace": true,
    "stripPunctuation": true,
    "note": "Comparison lowercases and strips every non-alphanumeric character, so casing and punctuation variants (`AUT` / `Aut`, `Les Mills` / `LesMills`) collide without needing an alias. Anything that differs by a WORD still needs one — `Fisher & Paykel Healthcare` and `Fisher and Paykel Healthcare` do not collide, because stripping the ampersand leaves `and` behind in only one of them. `stripStudentPrefix` retries `Student, AUT` and `Student - UoA` as the institution alone: the prefix says what the person does there, not who they belong to, and the institution is genuinely represented either way. An unlisted string becomes its own canonical id, derived by the same slug rule as an event name.",
    "stripStudentPrefix": true
  }
}
